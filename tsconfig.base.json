{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "declaration": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "rewriteRelativeImportExtensions": true,
    "noErrorTruncation": true,
    "strict": true
  }
}
